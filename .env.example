DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/campus
POSTGRES_DB=campus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=generate_fernet_key_here

MTUCI_TECH_BASE_URL=https://tech.mtuci.ru
# В мок-режиме сервис не обращается к порталу, использует фикстуры
MTUCI_MOCK=true

# Окружение: development | production (в production падаем без TOKEN_ENCRYPTION_KEY)
APP_ENV=development

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
