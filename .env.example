# Application
APP_ENV=development

# Backend service URLs for Docker Compose.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/campus
ELASTICSEARCH_URL=http://elasticsearch:9200
REDIS_URL=redis://redis:6379/0

# PostgreSQL container settings.
POSTGRES_DB=campus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT settings. Replace in non-local environments.
JWT_SECRET_KEY=change_me_generate_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required when APP_ENV=production.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# MTUCI/TECH integration.
MTUCI_TECH_BASE_URL=https://tech.mtuci.ru
MTUCI_MOCK=true

# CORS origins for local frontend and Grafana.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Grafana local admin password.
GF_SECURITY_ADMIN_PASSWORD=admin
